+import { describe, expect, it } from 'vitest'
+import { makeCharacter } from '../sheet/fixtures'
+import { buildPrintSheet } from './sheetData'
+
+const played = () => {
+  const c = makeCharacter({ inventory: [{ uid: 'a', itemId: 'longsword', qty: 1, equipped: true }] })
+  return { ...c, state: { ...c.state, currentHp: 12, tempHp: 4, spellSlotsUsed: [1, 0, 0, 0, 0, 0, 0, 0, 0], conditions: ['poisoned' as const], exhaustion: 1 } }
+}
+
+describe('buildPrintSheet', () => {
+  it('fills header, abilities, saves and skills from the engine', () => {
+    const s = buildPrintSheet(makeCharacter(), { withPlayState: false })
+    expect(s.classLine).toBe('Fighter 5 / Wizard 2')
+    expect(s.level).toBe(7)
+    expect(s.proficiencyBonus).toBe('+3')
+    expect(s.abilities).toHaveLength(6)
+    expect(s.saves.find(x => x.name === 'Strength')).toEqual({ name: 'Strength', bonus: '+6', proficient: true })
+    expect(s.skills).toHaveLength(18)
+  })
+
+  it('lists equipped weapons as attacks and shows inventory', () => {
+    const s = buildPrintSheet(played(), { withPlayState: false })
+    expect(s.attacks.map(a => a.name)).toContain('Longsword')
+    expect(s.equipment).toEqual([{ name: 'Longsword', qty: 1, equipped: true }])
+  })
+
+  it('leaves play state blank for pencil play', () => {
+    const s = buildPrintSheet(played(), { withPlayState: false })
+    expect(s.currentHp).toBeUndefined()
+    expect(s.tempHp).toBeUndefined()
+    expect(s.spellSlots[0]).toMatchObject({ label: '1st', used: 0 })
+    expect(s.conditions).toEqual([])
+    expect(s.exhaustion).toBe(0)
+  })
+
+  it('fills play state when asked', () => {
+    const s = buildPrintSheet(played(), { withPlayState: true })
+    expect(s.currentHp).toBe(12)
+    expect(s.tempHp).toBe(4)
+    expect(s.spellSlots[0].used).toBe(1)
+    expect(s.conditions).toEqual(['Poisoned'])
+    expect(s.exhaustion).toBe(1)
+  })
+
+  it('includes class resources and custom trackers', () => {
+    const c = makeCharacter()
+    const s = buildPrintSheet(
+      { ...c, state: { ...c.state, counters: [{ id: 'k', label: 'Arrows', max: 20, used: 3, recharge: 'none' }] } },
+      { withPlayState: true },
+    )
+    expect(s.resources.map(r => r.label)).toContain('Arrows')
+    expect(s.resources.find(r => r.label === 'Arrows')).toMatchObject({ max: 20, used: 3, note: undefined })
+  })
+})
diff --git a/src/print/sheetData.ts b/src/print/sheetData.ts
new file mode 100644
index 0000000..0c0cdd4
--- /dev/null
+++ b/src/print/sheetData.ts
@@ -0,0 +1,131 @@
+// Everything the printable sheet shows, flattened from a Character and derive(). Pure, no React.
+import type { Character } from '../model/character'
+import {
+  ABILITIES, ABILITY_NAMES, ALL_SKILLS, SKILLS, backgroundById, classById, derive, formatMod, itemById, raceById,
+  type Ability,
+} from '../rules'
+
+export interface PrintOptions {
+  /** Fill in current HP, used slots and resources. Off prints blank boxes for pencil play. */
+  withPlayState: boolean
+}
+
+export interface Pips {
+  label: string
+  max: number
+  used: number
+  note?: string
+}
+
+export interface PrintSheet {
+  name: string
+  playerName: string
+  classLine: string
+  level: number
+  race: string
+  background: string
+  alignment: string
+  xp: number
+  portrait?: string
+  abilities: { id: Ability; name: string; score: number; mod: string }[]
+  saves: { name: string; bonus: string; proficient: boolean }[]
+  skills: { name: string; ability: string; bonus: string; proficient: boolean }[]
+  proficiencyBonus: string
+  passivePerception: number
+  armorClass: number
+  armorSource: string
+  initiative: string
+  speed: number
+  maxHp: number
+  currentHp?: number
+  tempHp?: number
+  hitDice: string
+  spellcasting?: { ability: string; saveDc: number; attackBonus: string }
+  spellSlots: Pips[]
+  resources: Pips[]
+  attacks: { name: string; bonus: string; damage: string; notes: string }[]
+  equipment: { name: string; qty: number; equipped: boolean }[]
+  coins: { cp: number; sp: number; gp: number }
+  carried: string
+  features: string[]
+  traits: string[]
+  languages: string[]
+  conditions: string[]
+  exhaustion: number
+  warnings: string[]
+  notes: string
+}
+
+const ORDINAL = ['1st', '2nd', '3rd', '4th', '5th', '6th', '7th', '8th', '9th']
+const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)
+
+export function buildPrintSheet(c: Character, opts: PrintOptions): PrintSheet {
+  const d = derive(c)
+  const play = opts.withPlayState
+  const race = raceById(c.raceId)
+  const subrace = race?.subraces?.find(s => s.id === c.subraceId)
+
+  const spellSlots: Pips[] = d.spellSlots.slots.flatMap((max, i) =>
+    max > 0 ? [{ label: ORDINAL[i], max, used: play ? (c.state.spellSlotsUsed[i] ?? 0) : 0 }] : [],
+  )
+  const pact = d.spellSlots.pact
+  if (pact) {
+    spellSlots.push({ label: `Pact (${ORDINAL[pact.level - 1]})`, max: pact.count, used: play ? c.state.pactSlotsUsed : 0, note: 'short rest' })
+  }
+
+  const resources: Pips[] = [
+    ...d.resources.map(r => ({
+      label: r.label, max: r.max, used: play ? (c.state.resources[r.id]?.used ?? 0) : 0, note: `${r.recharge} rest`,
+    })),
+    ...(c.state.counters ?? []).map(k => ({
+      label: k.label, max: k.max, used: play ? k.used : 0, note: k.recharge === 'none' ? undefined : `${k.recharge} rest`,
+    })),
+  ]
+
+  return {
+    name: c.name,
+    playerName: c.playerName,
+    classLine: c.classes.map(cl => `${classById(cl.classId)?.name ?? cl.classId} ${cl.level}`).join(' / '),
+    level: d.level,
+    race: subrace?.name ?? race?.name ?? c.raceId,
+    background: backgroundById(c.backgroundId)?.name ?? c.backgroundId,
+    alignment: c.alignment,
+    xp: c.xp,
+    portrait: c.portrait,
+    abilities: ABILITIES.map(a => ({ id: a, name: ABILITY_NAMES[a], score: d.abilities[a], mod: formatMod(d.mods[a]) })),
+    saves: ABILITIES.map(a => ({ name: ABILITY_NAMES[a], bonus: formatMod(d.saves[a].bonus), proficient: d.saves[a].proficient })),
+    skills: ALL_SKILLS.map(s => ({
+      name: SKILLS[s].name, ability: SKILLS[s].ability.toUpperCase(), bonus: formatMod(d.skills[s].bonus), proficient: d.skills[s].proficient,
+    })),
+    proficiencyBonus: formatMod(d.proficiencyBonus),
+    passivePerception: d.passivePerception,
+    armorClass: d.armorClass.value,
+    armorSource: d.armorClass.source,
+    initiative: formatMod(d.initiative),
+    speed: d.speed,
+    maxHp: d.maxHp,
+    currentHp: play ? c.state.currentHp : undefined,
+    tempHp: play && c.state.tempHp > 0 ? c.state.tempHp : undefined,
+    hitDice: d.hitDice.map(h => `${h.total}${h.die}`).join(' + '),
+    spellcasting: d.spellcasting && {
+      ability: ABILITY_NAMES[d.spellcasting.ability],
+      saveDc: d.spellcasting.saveDc,
+      attackBonus: formatMod(d.spellcasting.attackBonus),
+    },
+    spellSlots,
+    resources,
+    attacks: d.attacks.map(a => ({
+      name: a.name, bonus: formatMod(a.bonus), damage: `${a.damage} ${a.damageType}`, notes: a.notes.join(', '),
+    })),
+    equipment: c.inventory.map(e => ({ name: itemById(e.itemId)?.name ?? e.itemId, qty: e.qty, equipped: e.equipped })),
+    coins: c.coins,
+    carried: `${d.carriedWeight} / ${d.carryingCapacity} lb`,
+    features: d.features.map(f => `${f.name} (${f.className} ${f.level})`),
+    traits: d.traits,
+    languages: d.languages,
+    conditions: play ? c.state.conditions.map(cap) : [],
+    exhaustion: play ? c.state.exhaustion : 0,
+    warnings: d.warnings,
+    notes: c.notes,
+  }
+}
